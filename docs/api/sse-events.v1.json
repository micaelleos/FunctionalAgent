{
  "$defs": {
    "ActionProposedEvent": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "event": {
          "const": "action_proposed",
          "default": "action_proposed",
          "title": "Event",
          "type": "string"
        },
        "kind": {
          "enum": [
            "create_issue",
            "update_issue",
            "create_page",
            "update_page",
            "create_space"
          ],
          "title": "Kind",
          "type": "string"
        },
        "preview": {
          "additionalProperties": true,
          "description": "Jira: project_key, project_name ou issue_key/url, issue_type, summary, priority, parent_key, markdown, sections [{title, markdown}], readiness, labels; em atualizações, before (valores atuais dos campos que mudam). Confluence (F20): title, page_type, summary, space {key, name, url}, parent_title ou url/version/previous_title, diff [{section, change: added|removed|changed, before, after}]; create_space: title, space_key, project_key, pages [títulos]",
          "title": "Preview",
          "type": "object"
        }
      },
      "required": [
        "action_id",
        "kind",
        "preview"
      ],
      "title": "ActionProposedEvent",
      "type": "object"
    },
    "DoneEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "done",
          "default": "done",
          "title": "Event",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "usage"
      ],
      "title": "DoneEvent",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "llm-unavailable",
            "turn-timeout",
            "tool-limit",
            "jira-auth",
            "internal",
            "quota-exceeded"
          ],
          "title": "Code",
          "type": "string"
        },
        "event": {
          "const": "error",
          "default": "error",
          "title": "Event",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "MessageSavedEvent": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "title": "Conversation Id",
          "type": "string"
        },
        "event": {
          "const": "message_saved",
          "default": "message_saved",
          "title": "Event",
          "type": "string"
        },
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "user_message_id": {
          "title": "User Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "conversation_id",
        "user_message_id"
      ],
      "title": "MessageSavedEvent",
      "type": "object"
    },
    "TokenEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "token",
          "default": "token",
          "title": "Event",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TokenEvent",
      "type": "object"
    },
    "ToolEndEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "tool_end",
          "default": "tool_end",
          "title": "Event",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "name",
        "summary"
      ],
      "title": "ToolEndEvent",
      "type": "object"
    },
    "ToolStartEvent": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "tool_start",
          "default": "tool_start",
          "title": "Event",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "name",
        "summary"
      ],
      "title": "ToolStartEvent",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "$id": "https://specsflow-ai.web.app/schemas/sse-events.v1.json",
  "discriminator": {
    "mapping": {
      "action_proposed": "#/$defs/ActionProposedEvent",
      "done": "#/$defs/DoneEvent",
      "error": "#/$defs/ErrorEvent",
      "message_saved": "#/$defs/MessageSavedEvent",
      "token": "#/$defs/TokenEvent",
      "tool_end": "#/$defs/ToolEndEvent",
      "tool_start": "#/$defs/ToolStartEvent"
    },
    "propertyName": "event"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TokenEvent"
    },
    {
      "$ref": "#/$defs/ToolStartEvent"
    },
    {
      "$ref": "#/$defs/ToolEndEvent"
    },
    {
      "$ref": "#/$defs/ActionProposedEvent"
    },
    {
      "$ref": "#/$defs/MessageSavedEvent"
    },
    {
      "$ref": "#/$defs/ErrorEvent"
    },
    {
      "$ref": "#/$defs/DoneEvent"
    }
  ],
  "title": "Eventos SSE do chat v1"
}
