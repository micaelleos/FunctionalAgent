{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "env": {
            "title": "Env",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "env"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JiraConnection": {
        "description": "O que a API devolve: nunca o token, só os 4 últimos caracteres (F04-RF-04).",
        "properties": {
          "account_name": {
            "title": "Account Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_validated_at": {
            "format": "date-time",
            "title": "Last Validated At",
            "type": "string"
          },
          "site_url": {
            "title": "Site Url",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "invalid"
            ],
            "title": "Status",
            "type": "string"
          },
          "token_hint": {
            "title": "Token Hint",
            "type": "string"
          }
        },
        "required": [
          "id",
          "site_url",
          "email",
          "account_name",
          "token_hint",
          "status",
          "last_validated_at"
        ],
        "title": "JiraConnection",
        "type": "object"
      },
      "JiraConnectionInput": {
        "properties": {
          "api_token": {
            "format": "password",
            "maxLength": 2048,
            "minLength": 8,
            "title": "Api Token",
            "type": "string",
            "writeOnly": true
          },
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "site_url": {
            "examples": [
              "https://sua-empresa.atlassian.net"
            ],
            "maxLength": 300,
            "title": "Site Url",
            "type": "string"
          }
        },
        "required": [
          "site_url",
          "email",
          "api_token"
        ],
        "title": "JiraConnectionInput",
        "type": "object"
      },
      "Profile": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "uid": {
            "title": "Uid",
            "type": "string"
          }
        },
        "required": [
          "uid",
          "display_name",
          "email",
          "created_at",
          "locale"
        ],
        "title": "Profile",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
