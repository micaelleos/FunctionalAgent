{
  "components": {
    "schemas": {
      "ActionError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ActionError",
        "type": "object"
      },
      "ActionOut": {
        "description": "O cartão inteiro: o que vai ao Jira (`preview`), a prontidão e o estado (F06-RF-01).",
        "properties": {
          "conversation_id": {
            "title": "Conversation Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActionError"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "create_issue",
              "update_issue"
            ],
            "title": "Kind",
            "type": "string"
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "preview": {
            "additionalProperties": true,
            "title": "Preview",
            "type": "object"
          },
          "readiness": {
            "additionalProperties": true,
            "title": "Readiness",
            "type": "object"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActionResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "pending",
              "executing",
              "done",
              "failed",
              "rejected",
              "expired"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "conversation_id",
          "preview",
          "readiness",
          "labels",
          "created_at",
          "expires_at"
        ],
        "title": "ActionOut",
        "type": "object"
      },
      "ActionResult": {
        "properties": {
          "issue_key": {
            "title": "Issue Key",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "issue_key",
          "url"
        ],
        "title": "ActionResult",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "env": {
            "title": "Env",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "env"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JiraConnection": {
        "description": "O que a API devolve: nunca o token, só os 4 últimos caracteres (F04-RF-04).",
        "properties": {
          "account_name": {
            "title": "Account Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "last_validated_at": {
            "format": "date-time",
            "title": "Last Validated At",
            "type": "string"
          },
          "site_url": {
            "title": "Site Url",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "invalid"
            ],
            "title": "Status",
            "type": "string"
          },
          "token_hint": {
            "title": "Token Hint",
            "type": "string"
          }
        },
        "required": [
          "id",
          "site_url",
          "email",
          "account_name",
          "token_hint",
          "status",
          "last_validated_at"
        ],
        "title": "JiraConnection",
        "type": "object"
      },
      "JiraConnectionInput": {
        "properties": {
          "api_token": {
            "format": "password",
            "maxLength": 2048,
            "minLength": 8,
            "title": "Api Token",
            "type": "string",
            "writeOnly": true
          },
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^@\\s]+@[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "site_url": {
            "examples": [
              "https://sua-empresa.atlassian.net"
            ],
            "maxLength": 300,
            "title": "Site Url",
            "type": "string"
          }
        },
        "required": [
          "site_url",
          "email",
          "api_token"
        ],
        "title": "JiraConnectionInput",
        "type": "object"
      },
      "MessageInput": {
        "properties": {
          "content": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "MessageInput",
        "type": "object"
      },
      "Profile": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "uid": {
            "title": "Uid",
            "type": "string"
          }
        },
        "required": [
          "uid",
          "display_name",
          "email",
          "created_at",
          "locale"
        ],
        "title": "Profile",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SpecFlow AI API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/actions/{action_id}/confirm": {
      "post": {
        "operationId": "confirm_api_v1_actions__action_id__confirm_post",
        "parameters": [
          {
            "in": "path",
            "name": "action_id",
            "required": true,
            "schema": {
              "title": "Action Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Ação inexistente ou de outro usuário"
          },
          "409": {
            "description": "Já concluída, recusada ou em execução; `action` traz o estado"
          },
          "410": {
            "description": "Expirada (24 h)"
          },
          "422": {
            "description": "O Jira não executou; `detail` traz o erro traduzido"
          },
          "503": {
            "description": "Escritas no Jira desligadas"
          }
        },
        "summary": "Confirma e executa a ação exatamente como exibida",
        "tags": [
          "actions"
        ]
      }
    },
    "/api/v1/actions/{action_id}/reject": {
      "post": {
        "operationId": "reject_api_v1_actions__action_id__reject_post",
