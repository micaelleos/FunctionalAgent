{
  "name": "functional-agent-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "VITE_DEMO_DATA=true vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-no-demo.mjs && node scripts/check-bundle-size.mjs",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript openapi.json -o src/lib/api-schema.d.ts"
  },
  "dependencies": {
    "@firebase/app": "0.16.2",
    "@firebase/app-check": "0.13.1",
    "@firebase/auth": "1.13.6",
    "@tanstack/react-query": "5.105.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "10.1.0",
    "react-router": "7.18.5",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "1.49.1",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.10.2",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "26.0.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.4.2",
    "tailwindcss": "4.1.11",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
